# Copy to .env and fill in only the providers you want to run.
# A provider whose key is missing is skipped with "skipped, missing X". Never commit .env.

# ---- run settings (override clipbench.toml)
# Language to benchmark: ja, es or ko.
CLIPBENCH_LANGUAGE=ja
# Hard cap on paid API spend for a run, in USD.
CLIPBENCH_BUDGET_USD=10
# Path to the Vako checkout that holds the source videos and captions.
# CLIPBENCH_VAKO_ROOT=../Vako/Vako

# ---- Groq (whisper-large-v3). https://console.groq.com/keys
# Billed per request with a 10 s minimum. Enable Zero Data Retention in console Data Controls.
GROQ_API_KEY=

# ---- Deepgram (nova-3). https://console.deepgram.com
# The adapter sends mip_opt_out=true on every request.
DEEPGRAM_API_KEY=

# ---- AssemblyAI (universal-3-5-pro, falls back to universal-2 for ko). https://www.assemblyai.com/dashboard
# Training opt-out is an account Data Controls toggle (paid plans). The adapter deletes each transcript after use.
ASSEMBLYAI_API_KEY=

# ---- ElevenLabs (scribe_v2). https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Set to 1 only on an Enterprise plan: sends enable_logging=false (zero retention). Other plans reject it.
CLIPBENCH_ELEVENLABS_ZERO_RETENTION=0

# ---- Google Gemini (gemini-3.8-flash). https://aistudio.google.com/apikey
# Use a key on a billing-enabled project: free tier data may be used to improve Google products.
GEMINI_API_KEY=

# ---- Amazon Transcribe (batch via S3). Needs s3:PutObject/GetObject/DeleteObject on the bucket and
# transcribe:StartTranscriptionJob/GetTranscriptionJob/DeleteTranscriptionJob. Install with the 'aws' extra.
# Objects go under clipbench-tmp/ and are deleted after each clip. Opt out of AI service
# data use with an AWS Organizations AI services opt-out policy.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
CLIPBENCH_AWS_BUCKET=
