# Local secrets for `wrangler dev` (run from web/). Copy to web/.dev.vars, which is gitignored.
# In production set each one with `wrangler secret put NAME` (from web/). Never commit real values.
# Empty optional values switch the matching feature off; GET /api/auth-providers reports what is on.

# Required with accounts on. Signs session cookies and tokens. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Required with accounts on. Public origin of the site, no trailing slash. OAuth callbacks are <this>/api/auth/callback/<provider>.
BETTER_AUTH_URL=http://localhost:8787

# Optional. GitHub OAuth app (github.com/settings/developers). Callback: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. Google OAuth client, type "Web application" (console.cloud.google.com/apis/credentials).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Resend API key for magic link and alert emails. Unset locally: links and emails are printed to the
# wrangler log instead of sent. Unset in production: email sign-in is hidden and alerts are only logged.
RESEND_API_KEY=
# Sender for all email, on a domain verified in Resend, e.g. clipbench <hello@mail.example.com>
EMAIL_FROM=

# Optional. Needed for POST /api/admin/notify-new-run (Authorization: Bearer <token>). Generate: openssl rand -hex 32
ADMIN_TOKEN=

# Plain vars (wrangler.jsonc "vars"); override here for local dev if needed.
# "true" turns the account routes on (wrangler.jsonc default "false": only /api/v1 answers). Build the SPA with
# VITE_ACCOUNTS=1 to match.
ACCOUNTS=false
# Extra comma separated origins allowed on mutating routes, e.g. a Vite dev server: http://localhost:5173
TRUSTED_ORIGINS=http://localhost:5173
# "true" lets the hourly cron email watchers about a new latest run once.
AUTO_NOTIFY=false

# /api/try (the /try playground). Cloudflare Turnstile secret for the widget whose site key the SPA is built with
# (VITE_TURNSTILE_SITE_KEY). Locally use Cloudflare's documented always-pass test secret below; in production
# `wrangler secret put TURNSTILE_SECRET` with the real one.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Provider keys for /api/try. Leave empty locally: those providers report "not configured" and nothing is billed.
GROQ_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Global /api/try spend cap per UTC day in USD (wrangler.jsonc default "1.00").
TRY_DAILY_BUDGET_USD=1.00
# "1" replaces every /api/try provider with a synthetic one (no network, no cost). Honoured only when the request
# host is localhost or 127.0.0.1, so it can never switch production off.
TRY_FAKE_PROVIDERS=
# Shared secret with the clipbench.abhishekbr.com forwarding Worker (web/proxy/). With the right key, per-IP limits
# use its x-clipbench-client-ip header. Generate: openssl rand -hex 32. Empty locally.
PROXY_KEY=
