# Security headers for static assets (Workers static assets / Cloudflare _headers format).
# The inline theme script in index.html is allowed by its hash; if you edit that script, recompute it:
#   python3 -c "import re,hashlib,base64;s=open('index.html').read();print(base64.b64encode(hashlib.sha256(re.search(r'<script>(.*?)</script>',s,re.S).group(1).encode()).digest()).decode())"
# /try: Cloudflare Turnstile needs script-src and frame-src https://challenges.cloudflare.com; recording needs microphone=(self).
# Fonts are self-hosted (@fontsource; small subsets are inlined as data: URIs by Vite), so no font or style hosts are needed. Avatars come from GitHub and Google; clip thumbnails from i.ytimg.com (public video ids only).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-E7A0tFBGpn/yTwX9/LIja5IoVwxZ42TVJlmdEwIXqZg=' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://avatars.githubusercontent.com https://*.googleusercontent.com https://i.ytimg.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=300
