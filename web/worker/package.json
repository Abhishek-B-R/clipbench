{
  "name": "clipbench-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd .. && wrangler dev",
    "deploy": "cd .. && wrangler deploy",
    "types": "cd .. && wrangler types --strict-vars=false worker/worker-configuration.d.ts",
    "migrate:local": "cd .. && wrangler d1 migrations apply clipbench --local",
    "migrate:remote": "cd .. && wrangler d1 migrations apply clipbench --remote",
    "typecheck": "bun run types && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "better-auth": "1.7.11",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  }
}
