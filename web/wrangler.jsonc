// clipbench web: one Worker serves the built SPA (dist/) and the API under /api/*.
// Backend owns this file (docs/WEB.md). Run wrangler from web/ (see web/worker/package.json scripts).
{
  "$schema": "./worker/node_modules/wrangler/config-schema.json",
  "name": "clipbench",
  "main": "./worker/src/index.ts",
  "compatibility_date": "2026-10-12",
  // Better Auth needs AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],

  // Served on the account's workers.dev address. To use a custom domain later, add
  // "routes": [{ "pattern": "<host>", "custom_domain": true }] (the zone must be in this same account).
  "workers_dev": true,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clipbench",
      // `wrangler d1 create clipbench` prints the real id; paste it here before the first deploy.
      "database_id": "8b4c2cf0-4869-417e-8fd9-583b1fd20593",
      "migrations_dir": "migrations"
    }
  ],

  // Workers AI for the /try playground (@cf/openai/whisper-large-v3-turbo, @cf/deepgram/nova-3). Billed per neuron.
  "ai": { "binding": "AI" },

  // Public data API limits, per minute. Anonymous: keyed by client IP. API key: keyed by key id.
  // namespace_id must be unique per rate limiter within the account.
  "ratelimits": [
    { "name": "ANON_LIMITER", "namespace_id": "4101", "simple": { "limit": 30, "period": 60 } },
    { "name": "KEY_LIMITER", "namespace_id": "4102", "simple": { "limit": 600, "period": 60 } }
  ],

  "vars": {
    // "true" turns on accounts (sign-in, watchlist, alerts, comparisons, requests, API keys). Off: every /api route
    // except /api/v1 answers 404 and no auth secret is needed. Keep in step with VITE_ACCOUNTS in the frontend build.
    "ACCOUNTS": "false",
    // Comma separated extra origins allowed to call mutating routes (the BETTER_AUTH_URL origin is always allowed).
    "TRUSTED_ORIGINS": "",
    // "true" lets the hourly cron email watchers about a new latest run. Off until a human checks the run.
    "AUTO_NOTIFY": "false",
    // /api/try (the /try playground): global spend cap per UTC day in USD across all providers. Each run reserves
    // the estimated cost of every provider before calling them; a spent day answers 429 until 00:00 UTC.
    "TRY_DAILY_BUDGET_USD": "1.00"
  },

  // Secrets: set with `wrangler secret put NAME` in production and in .dev.vars locally (see .dev.vars.example).
  // None is needed while ACCOUNTS is "false". With accounts on: BETTER_AUTH_SECRET and BETTER_AUTH_URL are required;
  // GITHUB_*, GOOGLE_*, RESEND_API_KEY, EMAIL_FROM and ADMIN_TOKEN are optional (empty switches that feature off).
  // There is deliberately no "secrets.required" block: it makes the first `wrangler deploy` fail until every listed
  // secret exists, and it limits which .dev.vars keys load locally.
  // /api/try needs TURNSTILE_SECRET and GROQ_API_KEY, DEEPGRAM_API_KEY, ELEVENLABS_API_KEY (a provider without
  // its key reports an error card; the others still run). PROXY_KEY is shared with web/proxy/.
  // Types for them live in worker/src/env.d.ts.

  "triggers": { "crons": ["17 * * * *"] },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true }
  }
}
